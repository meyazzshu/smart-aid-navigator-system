@model SmartAidNavigator.Web.ViewModels.ShelterRequestIndexVm

@{
    ViewData["Title"] = "Shelter Requests";

    string StatusSelected(string value)
    {
        return Model.Status == value ? "selected" : "";
    }

    string SortSelected(string value)
    {
        return Model.SortBy == value ? "selected" : "";
    }
}

<div class="app-page-header">
    <div>
        <h2 class="page-title">
            <i class="fa-solid fa-person-shelter me-2"></i>Shelter Requests
        </h2>
        <p class="text-muted mb-0">
            Review public PPS booking requests submitted to your shelter.
        </p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check me-1"></i>@TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>@TempData["Error"]
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a asp-controller="ShelterRequests" asp-action="Index" asp-route-sortBy="newest" class="stat-card text-decoration-none">
            <div class="stat-card-icon blue"><i class="fa-solid fa-list-check"></i></div>
            <div>
                <div class="stat-card-value">@Model.TotalCount</div>
                <div class="stat-card-label">Total Requests</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="ShelterRequests" asp-action="Index" asp-route-status="PENDING" asp-route-sortBy="pending" class="stat-card text-decoration-none">
            <div class="stat-card-icon orange"><i class="fa-solid fa-hourglass-half"></i></div>
            <div>
                <div class="stat-card-value">@Model.PendingCount</div>
                <div class="stat-card-label">Pending</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="ShelterRequests" asp-action="Index" asp-route-status="CONFIRMED" asp-route-sortBy="confirmed" class="stat-card text-decoration-none">
            <div class="stat-card-icon purple"><i class="fa-solid fa-circle-check"></i></div>
            <div>
                <div class="stat-card-value">@Model.ConfirmedCount</div>
                <div class="stat-card-label">Confirmed</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="ShelterRequests" asp-action="Index" asp-route-status="ARRIVED" asp-route-sortBy="arrived" class="stat-card text-decoration-none">
            <div class="stat-card-icon green"><i class="fa-solid fa-door-open"></i></div>
            <div>
                <div class="stat-card-value">@Model.ArrivedCount</div>
                <div class="stat-card-label">Arrived</div>
            </div>
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <i class="fa-solid fa-filter me-2 text-primary"></i>Filter Shelter Requests
    </div>

    <div class="card-body">
        <form method="get" asp-controller="ShelterRequests" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="PENDING" selected="@StatusSelected("PENDING")">Pending</option>
                    <option value="CONFIRMED" selected="@StatusSelected("CONFIRMED")">Confirmed</option>
                    <option value="ARRIVED" selected="@StatusSelected("ARRIVED")">Arrived</option>
                    <option value="CANCELLED" selected="@StatusSelected("CANCELLED")">Cancelled</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Sort By</label>
                <select name="sortBy" class="form-select">
                    <option value="newest" selected="@SortSelected("newest")">Newest Requested</option>
                    <option value="oldest" selected="@SortSelected("oldest")">Oldest Requested</option>
                    <option value="name-asc" selected="@SortSelected("name-asc")">Requester A-Z</option>
                    <option value="name-desc" selected="@SortSelected("name-desc")">Requester Z-A</option>
                    <option value="people-high" selected="@SortSelected("people-high")">Total People High-Low</option>
                    <option value="people-low" selected="@SortSelected("people-low")">Total People Low-High</option>
                    <option value="pending" selected="@SortSelected("pending")">Pending First</option>
                    <option value="confirmed" selected="@SortSelected("confirmed")">Confirmed First</option>
                    <option value="arrived" selected="@SortSelected("arrived")">Arrived First</option>
                    <option value="cancelled" selected="@SortSelected("cancelled")">Cancelled First</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input name="search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Search name, phone, email, or request ID..." />
            </div>

            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Apply
                </button>

                <a asp-controller="ShelterRequests" asp-action="Index" class="btn btn-outline-secondary">
                    Reset
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="fa-solid fa-list me-2 text-primary"></i>Shelter Request Records</span>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border">15 records per page</span>
            <span class="badge bg-secondary">@Model.Rows.Count record(s)</span>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model.Rows.Any())
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th><i class="fa-solid fa-user me-1"></i>Requester</th>
                        <th><i class="fa-solid fa-phone me-1"></i>Contact</th>
                        <th><i class="fa-solid fa-users me-1"></i>Total People</th>
                        <th><i class="fa-solid fa-people-roof me-1"></i>Dependents</th>
                        <th><i class="fa-solid fa-circle-info me-1"></i>Status</th>
                        <th><i class="fa-solid fa-calendar me-1"></i>Requested</th>
                        <th style="width:130px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        var badge = r.Status switch
                        {
                            "ARRIVED" => "bg-success",
                            "CONFIRMED" => "bg-primary",
                            "CANCELLED" => "bg-danger",
                            _ => "bg-warning text-dark"
                        };

                        <tr class="shelter-request-record-row @(r.Status == "PENDING" ? "table-warning" : "")">
                            <td>
                                <i class="fa-solid fa-circle-user me-1 text-muted"></i>
                                <strong>@(string.IsNullOrWhiteSpace(r.FullName) ? "-" : r.FullName)</strong>
                                <div class="text-muted small">Request #@r.RequestId</div>
                            </td>

                            <td>
                                <div>@(string.IsNullOrWhiteSpace(r.Phone) ? "-" : r.Phone)</div>
                                <div class="text-muted small">@(string.IsNullOrWhiteSpace(r.Email) ? "-" : r.Email)</div>
                            </td>

                            <td>
                                <span class="badge bg-secondary">@r.TotalPeople</span>
                            </td>

                            <td>
                                <span class="badge bg-light text-dark border">@r.DependentCount</span>
                            </td>

                            <td>
                                <span class="badge @badge">@r.Status</span>
                            </td>

                            <td class="text-muted small">
                                @r.CreatedAt.ToString("dd MMM yyyy HH:mm")
                            </td>

                            <td class="text-nowrap">
                                <a asp-controller="ShelterRequests"
                                   asp-action="Details"
                                   asp-route-id="@r.RequestId"
                                   class="btn btn-sm btn-info"
                                   title="View Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="donation-table-pagination" id="shelterRequestTablePagination">
                <div class="donation-table-page-info" id="shelterRequestTablePageInfo">
                    Showing 0 - 0 of 0 requests
                </div>

                <div class="donation-table-page-actions">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="shelterRequestTablePrevBtn">
                        <i class="fa-solid fa-chevron-left me-1"></i>Previous
                    </button>

                    <span class="donation-table-page-number" id="shelterRequestTablePageNumber">
                        Page 1
                    </span>

                    <button type="button" class="btn btn-outline-secondary btn-sm" id="shelterRequestTableNextBtn">
                        Next<i class="fa-solid fa-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="p-3 text-muted small">
                <i class="fa-solid fa-inbox me-1"></i>No shelter requests found for the selected filter.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const pageSize = 15;

            const rows = Array.from(document.querySelectorAll('tr.shelter-request-record-row'));
            const pagination = document.getElementById('shelterRequestTablePagination');
            const pageInfo = document.getElementById('shelterRequestTablePageInfo');
            const pageNumber = document.getElementById('shelterRequestTablePageNumber');
            const prevBtn = document.getElementById('shelterRequestTablePrevBtn');
            const nextBtn = document.getElementById('shelterRequestTableNextBtn');

            let currentPage = 1;

            function renderPage() {
                const total = rows.length;
                const totalPages = Math.max(Math.ceil(total / pageSize), 1);

                if (currentPage > totalPages) {
                    currentPage = totalPages;
                }

                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = startIndex + pageSize;

                rows.forEach((row, index) => {
                    const shouldHide = index < startIndex || index >= endIndex;
                    row.classList.toggle('d-none', shouldHide);
                });

                if (pagination) {
                    pagination.classList.toggle('d-none', total === 0);
                }

                if (pageInfo) {
                    const from = total > 0 ? startIndex + 1 : 0;
                    const to = Math.min(endIndex, total);
                    pageInfo.textContent = `Showing ${from} - ${to} of ${total} requests`;
                }

                if (pageNumber) {
                    pageNumber.textContent = `Page ${currentPage} of ${totalPages}`;
                }

                if (prevBtn) {
                    prevBtn.disabled = currentPage <= 1;
                }

                if (nextBtn) {
                    nextBtn.disabled = currentPage >= totalPages;
                }
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', function () {
                    if (currentPage > 1) {
                        currentPage--;
                        renderPage();
                    }
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function () {
                    const totalPages = Math.max(Math.ceil(rows.length / pageSize), 1);

                    if (currentPage < totalPages) {
                        currentPage++;
                        renderPage();
                    }
                });
            }

            renderPage();
        });
    </script>
}