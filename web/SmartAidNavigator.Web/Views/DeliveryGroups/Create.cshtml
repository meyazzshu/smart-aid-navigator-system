@model SmartAidNavigator.Web.ViewModels.DeliveryGroupCreateVm

@{
    ViewData["Title"] = "Create Group Delivery";
}

<div class="app-page-header">
    <div>
        <h1>Create Group Delivery</h1>
        <p class="text-muted mb-0">
            Select existing deliveries and group them into one optimized route.
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Back
    </a>
</div>

<form asp-action="Create" method="post" id="createGroupDeliveryForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm group-form-card sticky-lg-top">
                <div class="card-header">
                    <i class="fa fa-layer-group me-2"></i>
                    Group Information
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="GroupName" class="form-label fw-semibold"></label>
                        <input asp-for="GroupName"
                               class="form-control"
                               placeholder="Example: Flood Aid Batch #001" />
                        <span asp-validation-for="GroupName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                        <select asp-for="AssignedTo" asp-items="Model.StaffOptions" class="form-select">
                            <option value="">-- Not assigned yet --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ScheduledDate" class="form-label fw-semibold"></label>
                        <input asp-for="ScheduledDate" type="date" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Optional notes for this delivery group"></textarea>
                    </div>

                    <div class="group-selection-summary">
                        <div>
                            <span class="summary-label">Selected Deliveries</span>
                            <strong id="selectedDeliveryCount">0</strong>
                        </div>
                        <div>
                            <span class="summary-label">Minimum Required</span>
                            <strong>2</strong>
                        </div>
                    </div>

                    <span asp-validation-for="SelectedDeliveryIds" class="text-danger d-block mt-3"></span>

                    <button type="submit" class="btn btn-primary w-100 mt-3" id="createGroupBtn">
                        <i class="fa fa-check-circle me-1"></i>
                        Create Group Delivery
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm delivery-picker-card">
                <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <i class="fa fa-truck me-2"></i>
                        Choose Existing Deliveries
                    </div>

                    <span class="badge bg-light text-dark border">
                        @Model.DeliveryCards.Count available
                    </span>
                </div>

                <div class="card-body">
                    <div class="delivery-picker-toolbar">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fa fa-search"></i>
                            </span>
                            <input type="text"
                                   class="form-control"
                                   id="deliverySearchInput"
                                   placeholder="Search by delivery ID, shelter, city, state, items..." />
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <select class="form-select form-select-sm delivery-sort-select" id="deliverySortSelect">
                                <option value="id-desc" selected>Delivery ID: High to Low</option>
                                <option value="id-asc">Delivery ID: Low to High</option>
                                <option value="created-newest">Time Created: Newest First</option>
                                <option value="created-oldest">Time Created: Oldest First</option>
                                <option value="location-asc">Location: A to Z</option>
                                <option value="location-desc">Location: Z to A</option>
                            </select>

                            <button type="button" class="btn btn-outline-secondary btn-sm" id="selectAllVisibleBtn">
                                Select Visible
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="clearSelectionBtn">
                                Clear
                            </button>
                        </div>
                    </div>

                    <div class="form-text mb-3">
                        Choose any planned deliveries you want to group. Routed, in-transit, delivered, cancelled, and already grouped deliveries are hidden.
                    </div>

                    @if (!Model.DeliveryCards.Any())
                    {
                        <div class="empty-delivery-picker">
                            <i class="fa fa-box-open"></i>
                            <h5>No available deliveries</h5>
                            <p>
                                All deliveries may already be grouped, delivered, cancelled, or no deliveries have been created yet.
                            </p>
                            <a asp-controller="Delivery" asp-action="Create" class="btn btn-primary">
                                Create Individual Delivery
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="delivery-card-grid" id="deliveryCardGrid">
                            @foreach (var delivery in Model.DeliveryCards)
                            {
                                var checkboxId = $"delivery_{delivery.DeliveryId}";
                                var searchableText = $"{delivery.DeliveryId} {delivery.ShelterName} {delivery.AddressLine} {delivery.City} {delivery.State} {delivery.StatusLabel} {delivery.PriorityName} {delivery.ItemsSummary}".ToLower();

                                <label class="delivery-select-card"
                                       data-search="@searchableText"
                                       data-delivery-id="@delivery.DeliveryId"
                                       data-created="@delivery.CreatedAtSortValue"
                                       data-location="@delivery.LocationSortValue"
                                       for="@checkboxId">

                                    <input class="delivery-select-checkbox"
                                           type="checkbox"
                                           id="@checkboxId"
                                           name="SelectedDeliveryIds"
                                           value="@delivery.DeliveryId"
                                    @(delivery.IsSelected ? "checked" : "") />

                                    <div class="delivery-card-main">
                                        <div class="delivery-card-top">
                                            <div>
                                                <div class="delivery-id">
                                                    Delivery #@delivery.DeliveryId
                                                </div>
                                                <div class="delivery-shelter">
                                                    @delivery.ShelterName
                                                </div>
                                            </div>

                                            <span class="badge @delivery.StatusCssClass">
                                                @delivery.StatusLabel
                                            </span>
                                        </div>

                                        <div class="delivery-card-meta">
                                            <div>
                                                <i class="fa fa-calendar-alt"></i>
                                                Scheduled: @delivery.ScheduledDateText
                                            </div>

                                            <div>
                                                <i class="fa fa-clock"></i>
                                                Created: @delivery.CreatedAtText
                                            </div>

                                            <div>
                                                <i class="fa fa-map-marker-alt"></i>
                                                @delivery.LocationText
                                            </div>

                                            <div>
                                                <i class="fa fa-flag"></i>
                                                <span class="@delivery.PriorityCssClass">
                                                    @delivery.PriorityName
                                                </span>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(delivery.AddressLine))
                                        {
                                            <div class="delivery-address">
                                                @delivery.AddressLine
                                            </div>
                                        }

                                        <div class="delivery-items-box">
                                            <div class="items-title">
                                                <i class="fa fa-box"></i>
                                                Items
                                            </div>
                                            <div class="items-summary">
                                                @delivery.ItemsSummary
                                            </div>
                                        </div>

                                        <div class="delivery-card-footer">
                                            <span>
                                                <i class="fa fa-list"></i>
                                                @delivery.ItemTypeCount item type(s)
                                            </span>

                                            <span>
                                                <i class="fa fa-cubes"></i>
                                                @delivery.TotalQuantity total qty
                                            </span>

                                            @if (delivery.DistanceKm.HasValue)
                                            {
                                                <span>
                                                    <i class="fa fa-route"></i>
                                                    @delivery.DistanceKm.Value.ToString("0.00") km
                                                </span>
                                            }

                                            @if (delivery.EtaMinutes.HasValue)
                                            {
                                                <span>
                                                    <i class="fa fa-clock"></i>
                                                    @delivery.EtaMinutes min
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="delivery-selected-indicator">
                                        <i class="fa fa-check"></i>
                                    </div>
                                </label>
                            }
                        </div>

                        <div class="delivery-pagination-bar" id="deliveryPaginationBar">
                            <div class="delivery-page-info" id="deliveryPageInfo">
                                Showing 0 - 0 of 0 deliveries
                            </div>

                            <div class="delivery-page-actions">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="deliveryPrevPageBtn">
                                    <i class="fa fa-chevron-left me-1"></i> Previous
                                </button>

                                <span class="delivery-page-number" id="deliveryPageNumber">
                                    Page 1
                                </span>

                                <button type="button" class="btn btn-outline-secondary btn-sm" id="deliveryNextPageBtn">
                                    Next <i class="fa fa-chevron-right ms-1"></i>
                                </button>
                            </div>
                        </div>

                        <div class="no-delivery-search-result d-none" id="noDeliverySearchResult">
                            <i class="fa fa-search"></i>
                            <p>No deliveries match your search.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const pageSize = 10;

            const searchInput = document.getElementById('deliverySearchInput');
            const grid = document.getElementById('deliveryCardGrid');
            const cards = Array.from(document.querySelectorAll('.delivery-select-card'));
            const selectedCountEl = document.getElementById('selectedDeliveryCount');
            const selectAllVisibleBtn = document.getElementById('selectAllVisibleBtn');
            const clearSelectionBtn = document.getElementById('clearSelectionBtn');
            const sortSelect = document.getElementById('deliverySortSelect');
            const noResult = document.getElementById('noDeliverySearchResult');

            const paginationBar = document.getElementById('deliveryPaginationBar');
            const pageInfo = document.getElementById('deliveryPageInfo');
            const pageNumber = document.getElementById('deliveryPageNumber');
            const prevPageBtn = document.getElementById('deliveryPrevPageBtn');
            const nextPageBtn = document.getElementById('deliveryNextPageBtn');

            let currentPage = 1;
            let filteredCards = [...cards];

            function updateSelectedCount() {
                const count = document.querySelectorAll('.delivery-select-checkbox:checked').length;
                selectedCountEl.textContent = count;
            }

            function sortCards() {
                if (!grid || !sortSelect) return;

                const mode = sortSelect.value;

                cards.sort((a, b) => {
                    const aId = parseInt(a.dataset.deliveryId || '0', 10);
                    const bId = parseInt(b.dataset.deliveryId || '0', 10);

                    const aCreated = a.dataset.created || '';
                    const bCreated = b.dataset.created || '';

                    const aLocation = a.dataset.location || '';
                    const bLocation = b.dataset.location || '';

                    switch (mode) {
                        case 'id-asc':
                            return aId - bId;

                        case 'created-newest':
                            return bCreated.localeCompare(aCreated);

                        case 'created-oldest':
                            return aCreated.localeCompare(bCreated);

                        case 'location-asc':
                            return aLocation.localeCompare(bLocation) || bId - aId;

                        case 'location-desc':
                            return bLocation.localeCompare(aLocation) || bId - aId;

                        case 'id-desc':
                        default:
                            return bId - aId;
                    }
                });

                cards.forEach(card => grid.appendChild(card));
            }

            function filterCards() {
                const query = searchInput ? searchInput.value.trim().toLowerCase() : '';

                filteredCards = cards.filter(card => {
                    const text = card.dataset.search || '';
                    return text.includes(query);
                });

                currentPage = 1;
            }

            function renderPage() {
                const total = filteredCards.length;
                const totalPages = Math.max(Math.ceil(total / pageSize), 1);

                if (currentPage > totalPages) {
                    currentPage = totalPages;
                }

                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = startIndex + pageSize;
                const visibleSet = new Set(filteredCards.slice(startIndex, endIndex));

                cards.forEach(card => {
                    card.classList.toggle('d-none', !visibleSet.has(card));
                });

                const hasResults = total > 0;

                if (noResult) {
                    noResult.classList.toggle('d-none', hasResults);
                }

                if (paginationBar) {
                    paginationBar.classList.toggle('d-none', !hasResults);
                }

                if (pageInfo) {
                    const from = hasResults ? startIndex + 1 : 0;
                    const to = Math.min(endIndex, total);
                    pageInfo.textContent = `Showing ${from} - ${to} of ${total} deliveries`;
                }

                if (pageNumber) {
                    pageNumber.textContent = `Page ${currentPage} of ${totalPages}`;
                }

                if (prevPageBtn) {
                    prevPageBtn.disabled = currentPage <= 1;
                }

                if (nextPageBtn) {
                    nextPageBtn.disabled = currentPage >= totalPages;
                }
            }

            function refreshCards() {
                sortCards();
                filterCards();
                renderPage();
            }

            cards.forEach(card => {
                const checkbox = card.querySelector('.delivery-select-checkbox');

                if (!checkbox) return;

                checkbox.addEventListener('change', function () {
                    card.classList.toggle('selected', checkbox.checked);
                    updateSelectedCount();
                });

                card.classList.toggle('selected', checkbox.checked);
            });

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    filterCards();
                    renderPage();
                });
            }

            if (sortSelect) {
                sortSelect.addEventListener('change', function () {
                    currentPage = 1;
                    sortCards();
                    filterCards();
                    renderPage();
                });
            }

            if (prevPageBtn) {
                prevPageBtn.addEventListener('click', function () {
                    if (currentPage > 1) {
                        currentPage--;
                        renderPage();
                    }
                });
            }

            if (nextPageBtn) {
                nextPageBtn.addEventListener('click', function () {
                    const totalPages = Math.max(Math.ceil(filteredCards.length / pageSize), 1);

                    if (currentPage < totalPages) {
                        currentPage++;
                        renderPage();
                    }
                });
            }

            if (selectAllVisibleBtn) {
                selectAllVisibleBtn.addEventListener('click', function () {
                    const visibleCards = filteredCards.slice(
                        (currentPage - 1) * pageSize,
                        currentPage * pageSize
                    );

                    visibleCards.forEach(card => {
                        const checkbox = card.querySelector('.delivery-select-checkbox');

                        if (checkbox) {
                            checkbox.checked = true;
                            card.classList.add('selected');
                        }
                    });

                    updateSelectedCount();
                });
            }

            if (clearSelectionBtn) {
                clearSelectionBtn.addEventListener('click', function () {
                    cards.forEach(card => {
                        const checkbox = card.querySelector('.delivery-select-checkbox');

                        if (checkbox) {
                            checkbox.checked = false;
                            card.classList.remove('selected');
                        }
                    });

                    updateSelectedCount();
                });
            }

            updateSelectedCount();
            refreshCards();
        });
    </script>
}