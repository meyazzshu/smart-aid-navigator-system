@model SmartAidNavigator.Web.ViewModels.DependentUpsertVm
@{
    ViewData["Title"] = "Add Dependent";
}

<h2>Add Dependent</h2>

<form method="post">
    @Html.AntiForgeryToken()
    <partial name="_DependentFormFields" model="Model" />
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
