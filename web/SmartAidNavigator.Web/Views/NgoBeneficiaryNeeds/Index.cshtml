@model SmartAidNavigator.Web.ViewModels.NgoBeneficiaryNeedIndexVm

@{
    ViewData["Title"] = "Beneficiary Needs";

    string StatusSelected(string value) => Model.Status == value ? "selected" : "";
    string PrioritySelected(string value) => Model.Priority == value ? "selected" : "";
    string ShelterSelected(long value) => Model.ShelterId == value ? "selected" : "";
    string SortSelected(string value) => Model.SortBy == value ? "selected" : "";
}

<div class="app-page-header">
    <div>
        <h2 class="page-title">
            <i class="fa-solid fa-hand-holding-heart me-2"></i>Beneficiary Needs
        </h2>
        <p class="text-muted mb-0">
            View unmet beneficiary needs from shelters linked to your NGO.
        </p>
    </div>

    <span class="text-muted small">
        <i class="fa-solid fa-building-ngo me-1"></i>@Model.NgoName
    </span>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a asp-controller="NgoBeneficiaryNeeds" asp-action="Index" class="stat-card text-decoration-none">
            <div class="stat-card-icon blue"><i class="fa-solid fa-list-check"></i></div>
            <div>
                <div class="stat-card-value">@Model.TotalCount</div>
                <div class="stat-card-label">Total Needs</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="NgoBeneficiaryNeeds" asp-action="Index" asp-route-status="AWAITING_DONATION" asp-route-sortBy="awaiting" class="stat-card text-decoration-none">
            <div class="stat-card-icon red"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div>
                <div class="stat-card-value">@Model.AwaitingDonationCount</div>
                <div class="stat-card-label">Awaiting Donation</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="NgoBeneficiaryNeeds" asp-action="Index" asp-route-status="READY_FOR_PICKUP" asp-route-sortBy="ready" class="stat-card text-decoration-none">
            <div class="stat-card-icon green"><i class="fa-solid fa-box-circle-check"></i></div>
            <div>
                <div class="stat-card-value">@Model.ReadyForPickupCount</div>
                <div class="stat-card-label">Ready For Pickup</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="NgoBeneficiaryNeeds" asp-action="Index" asp-route-sortBy="high-critical" class="stat-card text-decoration-none">
            <div class="stat-card-icon orange"><i class="fa-solid fa-circle-exclamation"></i></div>
            <div>
                <div class="stat-card-value">@Model.HighCriticalCount</div>
                <div class="stat-card-label">High / Critical</div>
            </div>
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <i class="fa-solid fa-filter me-2 text-primary"></i>Filter Beneficiary Needs
    </div>

    <div class="card-body">
        <form method="get" asp-controller="NgoBeneficiaryNeeds" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="SUBMITTED" selected="@StatusSelected("SUBMITTED")">Submitted</option>
                    <option value="UNDER_REVIEW" selected="@StatusSelected("UNDER_REVIEW")">Under Review</option>
                    <option value="APPROVED" selected="@StatusSelected("APPROVED")">Approved</option>
                    <option value="AWAITING_DONATION" selected="@StatusSelected("AWAITING_DONATION")">Awaiting Donation</option>
                    <option value="READY_FOR_PICKUP" selected="@StatusSelected("READY_FOR_PICKUP")">Ready For Pickup</option>
                    <option value="FULFILLED" selected="@StatusSelected("FULFILLED")">Fulfilled</option>
                    <option value="REJECTED" selected="@StatusSelected("REJECTED")">Rejected</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Priority</label>
                <select name="priority" class="form-select">
                    <option value="">All Priorities</option>
                    <option value="CRITICAL" selected="@PrioritySelected("CRITICAL")">Critical</option>
                    <option value="HIGH" selected="@PrioritySelected("HIGH")">High</option>
                    <option value="MEDIUM" selected="@PrioritySelected("MEDIUM")">Medium</option>
                    <option value="LOW" selected="@PrioritySelected("LOW")">Low</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Shelter</label>
                <select name="shelterId" class="form-select">
                    <option value="">All Shelters</option>
                    @foreach (var shelter in Model.Shelters)
                    {
                        <option value="@shelter.ShelterId" selected="@ShelterSelected(shelter.ShelterId)">
                            @shelter.ShelterName
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Sort By</label>
                <select name="sortBy" class="form-select">
                    <option value="newest" selected="@SortSelected("newest")">Newest</option>
                    <option value="oldest" selected="@SortSelected("oldest")">Oldest</option>
                    <option value="awaiting" selected="@SortSelected("awaiting")">Awaiting Donation First</option>
                    <option value="ready" selected="@SortSelected("ready")">Ready First</option>
                    <option value="high-critical" selected="@SortSelected("high-critical")">High / Critical First</option>
                    <option value="shortage" selected="@SortSelected("shortage")">Biggest Shortage First</option>
                    <option value="ngo-stock" selected="@SortSelected("ngo-stock")">NGO Stock High-Low</option>
                    <option value="shelter-az" selected="@SortSelected("shelter-az")">Shelter A-Z</option>
                    <option value="item-az" selected="@SortSelected("item-az")">Item A-Z</option>
                </select>
            </div>

            <div class="col-md-9">
                <label class="form-label">Search</label>
                <input name="search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Search beneficiary, shelter, item, category, or notes..." />
            </div>

            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Apply
                </button>

                <a asp-controller="NgoBeneficiaryNeeds" asp-action="Index" class="btn btn-outline-secondary">
                    Reset
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="fa-solid fa-list me-2 text-primary"></i>Beneficiary Need Records</span>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border">15 records per page</span>
            <span class="badge bg-secondary">@Model.Rows.Count record(s)</span>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model.Rows.Any())
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Beneficiary</th>
                        <th>Shelter</th>
                        <th>Item Needed</th>
                        <th>Required</th>
                        <th>Shelter Stock</th>
                        <th>NGO Stock</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th style="width:90px;">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var priorityClass = row.Priority switch
                        {
                            "CRITICAL" => "bg-danger",
                            "HIGH" => "bg-danger",
                            "MEDIUM" => "bg-warning text-dark",
                            "LOW" => "bg-success",
                            _ => "bg-secondary"
                        };

                        var statusClass = row.RequestStatus switch
                        {
                            "AWAITING_DONATION" => "bg-danger",
                            "READY_FOR_PICKUP" => "bg-success",
                            "FULFILLED" => "bg-secondary",
                            "REJECTED" => "bg-dark",
                            "UNDER_REVIEW" => "bg-info text-dark",
                            "APPROVED" => "bg-primary",
                            "SUBMITTED" => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };

                        var shortage = row.RequiredQuantity - row.NgoStockQuantity;

                        <tr class="ngo-need-record-row @(row.RequestStatus == "AWAITING_DONATION" ? "table-warning" : "")">
                            <td>
                                <strong>@row.BeneficiaryName</strong>
                                <div class="text-muted small">Need ID: @row.NeedId</div>
                            </td>

                            <td>@row.ShelterName</td>

                            <td>
                                <div class="fw-semibold">@row.ItemName</div>
                                <div class="text-muted small">@row.CategoryName • @row.Unit</div>
                            </td>

                            <td>
                                <span class="badge bg-secondary">@row.RequiredQuantity</span>
                            </td>

                            <td>
                                <span class="badge @(row.ShelterStockQuantity >= row.RequiredQuantity ? "bg-success" : "bg-danger")">
                                    @row.ShelterStockQuantity
                                </span>
                            </td>

                            <td>
                                <span class="badge @(row.NgoStockQuantity >= row.RequiredQuantity ? "bg-success" : "bg-warning text-dark")">
                                    @row.NgoStockQuantity
                                </span>

                                @if (shortage > 0)
                                {
                                    <div class="text-danger small">Short: @shortage</div>
                                }
                            </td>

                            <td>
                                <span class="badge @priorityClass">@row.Priority</span>
                            </td>

                            <td>
                                <span class="badge @statusClass">@row.RequestStatus.Replace("_", " ")</span>
                            </td>

                            <td class="text-muted small">
                                @row.CreatedAt.ToString("dd MMM yyyy")
                            </td>

                            <td class="text-nowrap">
                                <a asp-controller="NgoBeneficiaryNeeds"
                                   asp-action="Details"
                                   asp-route-id="@row.NeedId"
                                   class="btn btn-sm btn-info"
                                   title="View Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>

                                @if (row.CanCreateDelivery)
                                {
                                    <a asp-controller="Delivery"
                                       asp-action="Create"
                                       asp-route-beneficiaryNeedId="@row.NeedId"
                                       class="btn btn-sm btn-success"
                                       title="Create Delivery">
                                        <i class="fa-solid fa-truck"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="donation-table-pagination" id="ngoNeedTablePagination">
                <div class="donation-table-page-info" id="ngoNeedTablePageInfo">
                    Showing 0 - 0 of 0 needs
                </div>

                <div class="donation-table-page-actions">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="ngoNeedTablePrevBtn">
                        <i class="fa-solid fa-chevron-left me-1"></i>Previous
                    </button>

                    <span class="donation-table-page-number" id="ngoNeedTablePageNumber">
                        Page 1
                    </span>

                    <button type="button" class="btn btn-outline-secondary btn-sm" id="ngoNeedTableNextBtn">
                        Next<i class="fa-solid fa-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="p-3 text-muted small">
                <i class="fa-solid fa-inbox me-1"></i>No beneficiary needs found.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const pageSize = 15;

            const rows = Array.from(document.querySelectorAll('tr.ngo-need-record-row'));
            const pagination = document.getElementById('ngoNeedTablePagination');
            const pageInfo = document.getElementById('ngoNeedTablePageInfo');
            const pageNumber = document.getElementById('ngoNeedTablePageNumber');
            const prevBtn = document.getElementById('ngoNeedTablePrevBtn');
            const nextBtn = document.getElementById('ngoNeedTableNextBtn');

            let currentPage = 1;

            function renderPage() {
                const total = rows.length;
                const totalPages = Math.max(Math.ceil(total / pageSize), 1);

                if (currentPage > totalPages) currentPage = totalPages;

                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = startIndex + pageSize;

                rows.forEach((row, index) => {
                    const shouldHide = index < startIndex || index >= endIndex;
                    row.classList.toggle('d-none', shouldHide);
                });

                if (pagination) pagination.classList.toggle('d-none', total === 0);

                if (pageInfo) {
                    const from = total > 0 ? startIndex + 1 : 0;
                    const to = Math.min(endIndex, total);
                    pageInfo.textContent = `Showing ${from} - ${to} of ${total} needs`;
                }

                if (pageNumber) pageNumber.textContent = `Page ${currentPage} of ${totalPages}`;
                if (prevBtn) prevBtn.disabled = currentPage <= 1;
                if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', function () {
                    if (currentPage > 1) {
                        currentPage--;
                        renderPage();
                    }
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function () {
                    const totalPages = Math.max(Math.ceil(rows.length / pageSize), 1);

                    if (currentPage < totalPages) {
                        currentPage++;
                        renderPage();
                    }
                });
            }

            renderPage();
        });
    </script>
}