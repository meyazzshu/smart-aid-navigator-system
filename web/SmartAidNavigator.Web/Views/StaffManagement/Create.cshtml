@model SmartAidNavigator.Web.ViewModels.StaffCreateVm

@{
    ViewData["Title"] = Model.PageTitle;

    var malaysiaStates = new[]
    {
        "Johor",
        "Kedah",
        "Kelantan",
        "Melaka",
        "Negeri Sembilan",
        "Pahang",
        "Perak",
        "Perlis",
        "Pulau Pinang",
        "Sabah",
        "Sarawak",
        "Selangor",
        "Terengganu",
        "Kuala Lumpur",
        "Labuan",
        "Putrajaya"
    };

    var ngoStaffTitles = new[]
    {
        "Owner",
        "Staff"
    };

    var shelterStaffTitles = new[]
    {
        "Shelter Manager",
        "Shelter Staff"
    };
}

<div class="app-page-header">
    <div>
        <h2 class="page-title">
            <i class="fa-solid fa-user-tie me-2"></i>@Model.PageTitle
        </h2>
        <p class="text-muted mb-0">
            Create a complete NGO staff account with personal details, NGO assignment, and Google address selection.
        </p>
    </div>

    <a asp-action="@Model.BackAction" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Back
    </a>
</div>

<form asp-action="@Model.PostAction" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PageTitle" />
    <input type="hidden" asp-for="PostAction" />
    <input type="hidden" asp-for="BackAction" />
    <input type="hidden" asp-for="StaffType" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card staff-edit-summary-card">
                <div class="card-body text-center">
                    <div class="staff-detail-avatar mx-auto mb-3">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>

                    <h4 class="mb-1">New @Model.StaffType</h4>
                    <div class="text-muted mb-3">Create staff account for @Model.StaffType</div>

                    <div class="mb-3">
                        <span class="badge bg-primary">
                            <i class="fa-solid fa-user-plus me-1"></i>New Staff
                        </span>
                    </div>

                    <div class="staff-edit-mini-info">
                        <div>
                            <i class="fa-solid fa-building-ngo me-2 text-primary"></i>
                            <span>Assign staff to selected NGO</span>
                        </div>

                        <div>
                            <i class="fa-solid fa-location-dot me-2 text-primary"></i>
                            <span>Use Google address search</span>
                        </div>

                        <div>
                            <i class="fa-solid fa-id-badge me-2 text-primary"></i>
                            <span>Role will be @(Model.StaffType == "NGO Staff" ? "NGO_STAFF" : "SHELTER_MANAGER")</span>
                        </div>
                    </div>

                    <hr />

                    <button type="submit" class="btn btn-primary w-100 mb-2">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Create Staff
                    </button>

                    <a asp-action="@Model.BackAction" class="btn btn-secondary w-100">
                        Cancel
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-user me-2 text-primary"></i>Basic Information
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold">
                                <i class="fa-solid fa-signature me-1 text-primary"></i>Full Name
                            </label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="fa-solid fa-envelope me-1 text-primary"></i>Email
                            </label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">
                                <i class="fa-solid fa-phone me-1 text-primary"></i>Phone
                            </label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IcOrPassport" class="form-label fw-semibold">
                                <i class="fa-solid fa-id-card me-1 text-primary"></i>IC / Passport
                            </label>
                            <input asp-for="IcOrPassport" class="form-control" />
                            <span asp-validation-for="IcOrPassport" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-semibold">
                                <i class="fa-solid fa-venus-mars me-1 text-primary"></i>Gender
                            </label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                <option value="MALE">Male</option>
                                <option value="FEMALE">Female</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold">
                                <i class="fa-solid fa-cake-candles me-1 text-primary"></i>Date of Birth
                            </label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-location-dot me-2 text-primary"></i>Address Information
                </div>

                <div class="card-body">
                    <div class="alert alert-info small mb-3">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Search and select an address from Google to auto-fill address, city, state, and postal code.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-magnifying-glass-location me-1 text-primary"></i>Search Location
                        </label>
                        <input type="text"
                               id="ngoStaffCreateGoogleLocationSearch"
                               class="form-control"
                               placeholder="Search staff address, building, street, or area..." />
                        <div class="form-text">
                            Example: Kuala Lumpur, Shah Alam, Seremban, or full address.
                        </div>
                    </div>

                    <div id="ngoStaffCreateMap" class="staff-edit-map mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="AddressLine" class="form-label fw-semibold">
                                <i class="fa-solid fa-map-location-dot me-1 text-primary"></i>Address Line
                            </label>
                            <input asp-for="AddressLine" id="AddressLine" class="form-control" />
                            <span asp-validation-for="AddressLine" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="City" class="form-label fw-semibold">
                                <i class="fa-solid fa-city me-1 text-primary"></i>City
                            </label>
                            <input asp-for="City" id="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="State" class="form-label fw-semibold">
                                <i class="fa-solid fa-map me-1 text-primary"></i>State
                            </label>
                            <select asp-for="State" id="State" class="form-select">
                                <option value="">-- Select State --</option>
                                @foreach (var state in malaysiaStates)
                                {
                                    <option value="@state">@state</option>
                                }
                            </select>
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PostalCode" class="form-label fw-semibold">
                                <i class="fa-solid fa-envelopes-bulk me-1 text-primary"></i>Postal Code
                            </label>
                            <input asp-for="PostalCode" id="PostalCode" class="form-control" />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-briefcase me-2 text-primary"></i>NGO Staff Assignment
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        @if (Model.StaffType == "NGO Staff")
                        {
                            var isMyNgoCreate = Model.PostAction == "CreateMyNgoStaff";

                            <div class="col-md-6">
                                <label asp-for="NgoId" class="form-label fw-semibold">
                                    <i class="fa-solid fa-building-ngo me-1 text-primary"></i>NGO
                                </label>

                                @if (isMyNgoCreate)
                                {
                                    <input type="hidden" asp-for="NgoId" />

                                    <select class="form-select" disabled>
                                        @foreach (var ngo in Model.NgoOptions)
                                        {
                                            <option selected>@ngo.Text</option>
                                        }
                                    </select>

                                    <div class="form-text">
                                        This staff will be created under your own NGO.
                                    </div>
                                }
                                else
                                {
                                    <select asp-for="NgoId" asp-items="Model.NgoOptions" class="form-select">
                                        <option value="">-- Select NGO --</option>
                                    </select>
                                }

                                <span asp-validation-for="NgoId" class="text-danger"></span>
                            </div>
                        }

                        @if (Model.StaffType == "Shelter Manager")
                        {
                            var isMyShelterCreate = Model.PostAction == "CreateMyShelterManager";

                            <div class="col-md-6">
                                <label asp-for="ShelterId" class="form-label fw-semibold">
                                    <i class="fa-solid fa-house-medical me-1 text-primary"></i>Shelter
                                </label>

                                @if (isMyShelterCreate)
                                {
                                    <input type="hidden" asp-for="ShelterId" />

                                    <select class="form-select" disabled>
                                        @foreach (var shelter in Model.ShelterOptions)
                                        {
                                            <option selected>@shelter.Text</option>
                                        }
                                    </select>

                                    <div class="form-text">
                                        This staff will be created under your own shelter.
                                    </div>
                                }
                                else
                                {
                                    <select asp-for="ShelterId" asp-items="Model.ShelterOptions" class="form-select">
                                        <option value="">-- Select Shelter --</option>
                                    </select>
                                }

                                <span asp-validation-for="ShelterId" class="text-danger"></span>
                            </div>
                        }

                        <div class="col-md-6">
                            <label asp-for="StaffTitle" class="form-label fw-semibold">
                                <i class="fa-solid fa-id-badge me-1 text-primary"></i>Staff Title
                            </label>

                            <select asp-for="StaffTitle" class="form-select">
                                <option value="">-- Select Staff Title --</option>

                                @if (Model.StaffType == "NGO Staff")
                                {
                                    foreach (var title in ngoStaffTitles)
                                    {
                                        <option value="@title">@title</option>
                                    }
                                }

                                @if (Model.StaffType == "Shelter Manager")
                                {
                                    foreach (var title in shelterStaffTitles)
                                    {
                                        <option value="@title">@title</option>
                                    }
                                }
                            </select>

                            <span asp-validation-for="StaffTitle" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IsActive" class="form-label fw-semibold">
                                <i class="fa-solid fa-toggle-on me-1 text-primary"></i>Account Status
                            </label>
                            <select asp-for="IsActive" class="form-select">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                            <span asp-validation-for="IsActive" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">
                                <i class="fa-solid fa-lock me-1 text-primary"></i>Password
                            </label>
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Minimum 6 characters" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-3">
                <a asp-action="@Model.BackAction" class="btn btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Create NGO Staff
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let ngoStaffCreateMap;
        let ngoStaffCreateMarker;
        let ngoStaffCreateAutocomplete;

        function initNgoStaffCreateAddressMap() {
            const mapElement = document.getElementById('ngoStaffCreateMap');
            const searchInput = document.getElementById('ngoStaffCreateGoogleLocationSearch');

            const addressInput = document.getElementById('AddressLine');
            const cityInput = document.getElementById('City');
            const stateInput = document.getElementById('State');
            const postalInput = document.getElementById('PostalCode');

            if (!mapElement || !searchInput) {
                return;
            }

            const defaultLocation = {
                lat: 3.1390,
                lng: 101.6869
            };

            ngoStaffCreateMap = new google.maps.Map(mapElement, {
                center: defaultLocation,
                zoom: 12,
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: true
            });

            ngoStaffCreateMarker = new google.maps.Marker({
                map: ngoStaffCreateMap,
                position: defaultLocation,
                draggable: false
            });

            ngoStaffCreateAutocomplete = new google.maps.places.Autocomplete(searchInput, {
                componentRestrictions: { country: 'my' },
                fields: ['address_components', 'formatted_address', 'geometry', 'name']
            });

            ngoStaffCreateAutocomplete.addListener('place_changed', function () {
                const place = ngoStaffCreateAutocomplete.getPlace();

                if (!place.geometry || !place.geometry.location) {
                    alert('Selected location does not have map coordinates. Please choose another result.');
                    return;
                }

                const location = place.geometry.location;

                ngoStaffCreateMap.setCenter(location);
                ngoStaffCreateMap.setZoom(16);
                ngoStaffCreateMarker.setPosition(location);

                const parsed = parseNgoStaffCreateAddressComponents(place.address_components || []);

                if (addressInput) {
                    addressInput.value = place.formatted_address || place.name || '';
                }

                if (cityInput) {
                    cityInput.value = parsed.city || '';
                }

                if (stateInput) {
                    stateInput.value = normalizeMalaysiaStateForNgoStaffCreate(parsed.state || '');
                }

                if (postalInput) {
                    postalInput.value = parsed.postalCode || '';
                }
            });
        }

        function parseNgoStaffCreateAddressComponents(components) {
            let city = '';
            let state = '';
            let postalCode = '';

            components.forEach(function (component) {
                const types = component.types || [];

                if (types.includes('postal_code')) {
                    postalCode = component.long_name;
                }

                if (
                    types.includes('locality') ||
                    types.includes('postal_town') ||
                    types.includes('administrative_area_level_2')
                ) {
                    if (!city) {
                        city = component.long_name;
                    }
                }

                if (types.includes('administrative_area_level_1')) {
                    state = component.long_name;
                }
            });

            return {
                city: city,
                state: state,
                postalCode: postalCode
            };
        }

        function normalizeMalaysiaStateForNgoStaffCreate(state) {
            const value = (state || '').toLowerCase();

            const map = {
                'johor': 'Johor',
                'kedah': 'Kedah',
                'kelantan': 'Kelantan',
                'melaka': 'Melaka',
                'malacca': 'Melaka',
                'negeri sembilan': 'Negeri Sembilan',
                'pahang': 'Pahang',
                'perak': 'Perak',
                'perlis': 'Perlis',
                'pulau pinang': 'Pulau Pinang',
                'penang': 'Pulau Pinang',
                'sabah': 'Sabah',
                'sarawak': 'Sarawak',
                'selangor': 'Selangor',
                'terengganu': 'Terengganu',
                'kuala lumpur': 'Kuala Lumpur',
                'federal territory of kuala lumpur': 'Kuala Lumpur',
                'wilayah persekutuan kuala lumpur': 'Kuala Lumpur',
                'labuan': 'Labuan',
                'putrajaya': 'Putrajaya',
                'federal territory of putrajaya': 'Putrajaya',
                'wilayah persekutuan putrajaya': 'Putrajaya'
            };

            return map[value] || state;
        }
    </script>

    @if (!string.IsNullOrWhiteSpace(ViewBag.GoogleMapsApiKey as string))
    {
        <script async
                defer
                src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&libraries=places&callback=initNgoStaffCreateAddressMap">
        </script>
    }
    else
    {
        <script>
            console.error('Google Maps API key is missing. NGO staff create map will not load.');
        </script>
    }
}