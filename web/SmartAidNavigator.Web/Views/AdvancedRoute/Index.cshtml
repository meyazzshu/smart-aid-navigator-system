@*                             <td> *@
@*                                 <ol class="mb-0 ps-3"> *@
@*                                     @foreach (var stop in route.Stops.OrderBy(x => x.StopOrder)) *@
@*                                     { *@
@*                                         <li class="small"> *@
@*                                             <strong>@(stop.Shelter?.ShelterName ?? "Unknown")</strong> *@
@*                                             — @stop.DistanceFromPrevKm km / @stop.EtaFromPrevMinutes min *@
@*                                         </li> *@
@*                                     } *@
@*                                 </ol> *@
@*                             </td> *@
@*                         </tr> *@
@*                     } *@
@*                 </tbody> *@
@*             </table> *@
@*         </div> *@
@*     </div> *@
@* } *@
