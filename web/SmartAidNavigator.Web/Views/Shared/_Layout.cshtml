@using SmartAidNavigator.Web.Helpers
@{
    var roles = Context.Session.GetString(SessionKeys.Roles) ?? "";
    var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString(SessionKeys.UserId));

    var isAdmin = roles.Contains("ADMIN");
    var isNgo = roles.Contains("NGO_STAFF");
    var isShelterMgr = roles.Contains("SHELTER_MANAGER");

    var currentCtrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    var currentAct = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();

    // Login and organization registration pages show title inside their own card/page.
    var isAuthPage = currentCtrl is "account" or "register" or "organizationregister";

    var userName = Context.Session.GetString(SessionKeys.FullName) ?? "User";
    var userEmail = Context.Session.GetString(SessionKeys.Email) ?? "";

    var nameParts = userName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length >= 2
        ? $"{char.ToUpper(nameParts[0][0])}{char.ToUpper(nameParts[^1][0])}"
        : (userName.Length > 0 ? $"{char.ToUpper(userName[0])}" : "U");

    var roleLabel = isAdmin ? "Administrator"
        : isNgo ? "NGO Staff"
        : isShelterMgr ? "Shelter Manager"
        : "User";

    string NavActive(string ctrl, string act = "")
    {
        var match = currentCtrl == ctrl.ToLowerInvariant();

        if (!string.IsNullOrEmpty(act))
        {
            match = match && currentAct == act.ToLowerInvariant();
        }

        return match ? "active" : "";
    }
}

