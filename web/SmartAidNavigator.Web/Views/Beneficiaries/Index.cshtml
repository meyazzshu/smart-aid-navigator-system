@model SmartAidNavigator.Web.ViewModels.BeneficiaryIndexVm
@using SmartAidNavigator.Web.Helpers

@{
    ViewData["Title"] = "Beneficiaries";

    string GenderSelected(string value)
    {
        return Model.Gender == value ? "selected" : "";
    }

    string AgeGroupSelected(string value)
    {
        return Model.AgeGroup == value ? "selected" : "";
    }

    string SortSelected(string value)
    {
        return Model.SortBy == value ? "selected" : "";
    }

    string StatusSelected(string value)
    {
        return Model.Status == value ? "selected" : "";
    }
}

<div class="app-page-header">
    <div>
        <h2 class="page-title">
            <i class="fa-solid fa-people-group me-2"></i>Beneficiaries
        </h2>
        <p class="text-muted mb-0">
            Manage registered beneficiaries under your shelter.
        </p>
    </div>

    <a class="btn btn-primary" asp-action="Create">
        <i class="fa-solid fa-person-circle-plus me-1"></i>Register Beneficiary
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check me-1"></i>@TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>@TempData["Error"]
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl">
        <a asp-controller="Beneficiaries"
           asp-action="Index"
           asp-route-sortBy="newest"
           class="stat-card text-decoration-none">
            <div class="stat-card-icon blue">
                <i class="fa-solid fa-people-group"></i>
            </div>
            <div>
                <div class="stat-card-value">@Model.TotalCount</div>
                <div class="stat-card-label">Total</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-4 col-xl">
        <a asp-controller="Beneficiaries"
           asp-action="Index"
           asp-route-status="ACTIVE"
           asp-route-sortBy="active-first"
           class="stat-card text-decoration-none">
            <div class="stat-card-icon teal">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <div>
                <div class="stat-card-value">@Model.ActiveCount</div>
                <div class="stat-card-label">Active</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-4 col-xl">
        <a asp-controller="Beneficiaries"
           asp-action="Index"
           asp-route-status="DISCHARGED"
           asp-route-sortBy="discharged-first"
           class="stat-card text-decoration-none">
            <div class="stat-card-icon orange">
                <i class="fa-solid fa-person-walking-arrow-right"></i>
            </div>
            <div>
                <div class="stat-card-value">@Model.DischargedCount</div>
                <div class="stat-card-label">Discharged</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-4 col-xl">
        <a asp-controller="Beneficiaries"
           asp-action="Index"
           asp-route-sortBy="male"
           class="stat-card text-decoration-none">
            <div class="stat-card-icon purple">
                <i class="fa-solid fa-person"></i>
            </div>
            <div>
                <div class="stat-card-value">@Model.MaleCount</div>
                <div class="stat-card-label">Male</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-4 col-xl">
        <a asp-controller="Beneficiaries"
           asp-action="Index"
           asp-route-sortBy="female"
           class="stat-card text-decoration-none">
            <div class="stat-card-icon teal">
                <i class="fa-solid fa-person-dress"></i>
            </div>
            <div>
                <div class="stat-card-value">@Model.FemaleCount</div>
                <div class="stat-card-label">Female</div>
            </div>
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <i class="fa-solid fa-filter me-2 text-primary"></i>Filter Beneficiaries
    </div>

    <div class="card-body">
        <form method="get" asp-controller="Beneficiaries" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="ACTIVE" selected="@StatusSelected("ACTIVE")">Active</option>
                    <option value="DISCHARGED" selected="@StatusSelected("DISCHARGED")">Discharged</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Gender</label>
                <select name="gender" class="form-select">
                    <option value="">All Gender</option>
                    <option value="Male" selected="@GenderSelected("Male")">Male</option>
                    <option value="Female" selected="@GenderSelected("Female")">Female</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Age Group</label>
                <select name="ageGroup" class="form-select">
                    <option value="">All Ages</option>
                    <option value="children" selected="@AgeGroupSelected("children")">Children &lt;18</option>
                    <option value="adult" selected="@AgeGroupSelected("adult")">Adult 18+</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Sort By</label>
                <select name="sortBy" class="form-select">
                    <option value="newest" selected="@SortSelected("newest")">Newest Registered</option>
                    <option value="oldest" selected="@SortSelected("oldest")">Oldest Registered</option>
                    <option value="active-first" selected="@SortSelected("active-first")">Active First</option>
                    <option value="discharged-first" selected="@SortSelected("discharged-first")">Discharged First</option>
                    <option value="name-asc" selected="@SortSelected("name-asc")">Name A-Z</option>
                    <option value="name-desc" selected="@SortSelected("name-desc")">Name Z-A</option>
                    <option value="male" selected="@SortSelected("male")">Male First</option>
                    <option value="female" selected="@SortSelected("female")">Female First</option>
                    <option value="children" selected="@SortSelected("children")">Children First</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Search</label>
                <input name="search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Search name, IC, or phone..." />
            </div>

            <div class="col-md-6 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Apply
                </button>

                <a asp-controller="Beneficiaries" asp-action="Index" class="btn btn-outline-secondary">
                    Reset
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="fa-solid fa-list me-2 text-primary"></i>Registered Beneficiaries</span>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border">15 records per page</span>
            <span class="badge bg-secondary">@Model.Rows.Count record(s)</span>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model.Rows.Any())
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th><i class="fa-solid fa-user me-1"></i>Full Name</th>
                        <th><i class="fa-solid fa-id-card me-1"></i>IC / Passport</th>
                        <th><i class="fa-solid fa-phone me-1"></i>Contact</th>
                        <th><i class="fa-solid fa-venus-mars me-1"></i>Gender</th>
                        <th><i class="fa-solid fa-cake-candles me-1"></i>Age</th>
                        <th><i class="fa-solid fa-circle-check me-1"></i>Status</th>
                        <th><i class="fa-solid fa-calendar me-1"></i>Registered</th>
                        <th style="width:300px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var b in Model.Rows)
                    {
                        var age = PersonHelper.CalculateAge(b.Person?.DateOfBirth);
                        var isChild = PersonHelper.IsChild(b.Person?.DateOfBirth);

                        <tr class="beneficiary-record-row @(isChild ? "table-warning" : "")">
                            <td>
                                <i class="fa-solid fa-circle-user me-1 text-muted"></i>
                                <strong>@(b.Person?.FullName ?? "-")</strong>
                                <div class="text-muted small">Beneficiary ID: @b.BeneficiaryId</div>
                            </td>

                            <td class="text-muted small">@(b.Person?.IcOrPassport ?? "-")</td>

                            <td>@(b.Person?.Phone ?? "-")</td>

                            <td>
                                @{
                                    var genderIcon = (b.Person?.Gender ?? "").ToLower() switch
                                    {
                                        "female" => "fa-person-dress text-danger",
                                        "male" => "fa-person text-primary",
                                        _ => "fa-genderless text-muted"
                                    };
                                }

                                <i class="fa-solid @genderIcon me-1"></i>@(b.Person?.Gender ?? "-")
                            </td>

                            <td>
                                @if (age.HasValue)
                                {
                                    <span class="badge @(age < 18 ? "bg-warning text-dark" : "bg-secondary")">
                                        @age
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td>
                                @{
                                    var statusClass = b.Status switch
                                    {
                                        "ACTIVE" => "bg-success",
                                        "DISCHARGED" => "bg-secondary",
                                        "TRANSFERRED" => "bg-info text-dark",
                                        "CANCELLED" => "bg-danger",
                                        _ => "bg-secondary"
                                    };

                                    var statusLabel = string.IsNullOrWhiteSpace(b.Status)
                                    ? "-"
                                    : b.Status.Replace("_", " ");
                                }

                                <span class="badge @statusClass">
                                    @statusLabel
                                </span>

                                @if (b.Status == "DISCHARGED" && b.DischargedAt.HasValue)
                                {
                                    <div class="text-muted small mt-1">
                                        @b.DischargedAt.Value.ToString("dd MMM yyyy")
                                    </div>
                                }
                            </td>

                            <td class="text-muted small">@b.CreatedAt.ToString("dd MMM yyyy")</td>

                            <td class="text-nowrap">
                                <div class="d-flex align-items-center gap-1">

                                    <a class="btn btn-sm btn-secondary"
                                       asp-controller="BeneficiaryNeeds"
                                       asp-action="IndividualNeeds"
                                       asp-route-beneficiaryId="@b.BeneficiaryId"
                                       title="Needs">
                                        <i class="fa-solid fa-hand-holding-heart me-1"></i>Needs
                                    </a>

                                    <a class="btn btn-sm btn-info"
                                       asp-action="Details"
                                       asp-route-id="@b.BeneficiaryId"
                                       title="View Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    <a class="btn btn-sm btn-warning"
                                       asp-action="Edit"
                                       asp-route-id="@b.BeneficiaryId"
                                       title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    @if (b.Status == "ACTIVE")
                                    {
                                        <form asp-action="Discharge"
                                              asp-route-id="@b.BeneficiaryId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Discharge this beneficiary from the shelter?');">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    title="Discharge">
                                                <i class="fa-solid fa-person-walking-arrow-right"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (b.Status == "DISCHARGED")
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-secondary"
                                                disabled
                                                title="Already discharged">
                                            <i class="fa-solid fa-check"></i>
                                        </button>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="donation-table-pagination" id="beneficiaryTablePagination">
                <div class="donation-table-page-info" id="beneficiaryTablePageInfo">
                    Showing 0 - 0 of 0 beneficiaries
                </div>

                <div class="donation-table-page-actions">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="beneficiaryTablePrevBtn">
                        <i class="fa-solid fa-chevron-left me-1"></i>Previous
                    </button>

                    <span class="donation-table-page-number" id="beneficiaryTablePageNumber">
                        Page 1
                    </span>

                    <button type="button" class="btn btn-outline-secondary btn-sm" id="beneficiaryTableNextBtn">
                        Next<i class="fa-solid fa-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="p-3 text-muted small">
                <i class="fa-solid fa-inbox me-1"></i>No beneficiaries found for the selected filter.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const pageSize = 15;

            const rows = Array.from(document.querySelectorAll('tr.beneficiary-record-row'));
            const pagination = document.getElementById('beneficiaryTablePagination');
            const pageInfo = document.getElementById('beneficiaryTablePageInfo');
            const pageNumber = document.getElementById('beneficiaryTablePageNumber');
            const prevBtn = document.getElementById('beneficiaryTablePrevBtn');
            const nextBtn = document.getElementById('beneficiaryTableNextBtn');

            let currentPage = 1;

            function renderPage() {
                const total = rows.length;
                const totalPages = Math.max(Math.ceil(total / pageSize), 1);

                if (currentPage > totalPages) {
                    currentPage = totalPages;
                }

                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = startIndex + pageSize;

                rows.forEach((row, index) => {
                    const shouldHide = index < startIndex || index >= endIndex;
                    row.classList.toggle('d-none', shouldHide);
                });

                if (pagination) {
                    pagination.classList.toggle('d-none', total === 0);
                }

                if (pageInfo) {
                    const from = total > 0 ? startIndex + 1 : 0;
                    const to = Math.min(endIndex, total);
                    pageInfo.textContent = `Showing ${from} - ${to} of ${total} beneficiaries`;
                }

                if (pageNumber) {
                    pageNumber.textContent = `Page ${currentPage} of ${totalPages}`;
                }

                if (prevBtn) {
                    prevBtn.disabled = currentPage <= 1;
                }

                if (nextBtn) {
                    nextBtn.disabled = currentPage >= totalPages;
                }
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', function () {
                    if (currentPage > 1) {
                        currentPage--;
                        renderPage();
                    }
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function () {
                    const totalPages = Math.max(Math.ceil(rows.length / pageSize), 1);

                    if (currentPage < totalPages) {
                        currentPage++;
                        renderPage();
                    }
                });
            }

            renderPage();
        });
    </script>
}