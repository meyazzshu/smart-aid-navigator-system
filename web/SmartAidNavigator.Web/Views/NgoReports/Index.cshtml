@{
    ViewData["Title"] = "NGO Reports";
}

<div class="app-page-header">
    <div>
        <h2 class="page-title">
            <i class="fa-solid fa-chart-pie me-2"></i>NGO Reports
        </h2>
        <p class="text-muted mb-0">
            Generate operational reports for donations, aid distribution, deliveries, and route planning.
        </p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <a class="stat-card text-decoration-none" asp-action="DonationManagement">
            <div class="stat-card-icon purple"><i class="fa-solid fa-hand-holding-dollar"></i></div>
            <div>
                <div class="stat-card-value" style="font-size:1rem;">Donation Management</div>
                <div class="stat-card-label">Donation records</div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-xl-3">
        <a class="stat-card text-decoration-none" asp-action="AidDistribution">
            <div class="stat-card-icon green"><i class="fa-solid fa-boxes-stacked"></i></div>
            <div>
                <div class="stat-card-value" style="font-size:1rem;">Aid Distribution</div>
                <div class="stat-card-label">Distributed aid items</div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-xl-3">
        <a class="stat-card text-decoration-none" asp-action="DeliveryPerformance">
            <div class="stat-card-icon orange"><i class="fa-solid fa-truck-fast"></i></div>
            <div>
                <div class="stat-card-value" style="font-size:1rem;">Delivery Performance</div>
                <div class="stat-card-label">Delivery progress</div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-xl-3">
        <a class="stat-card text-decoration-none" asp-action="RoutePlanning">
            <div class="stat-card-icon blue"><i class="fa-solid fa-route"></i></div>
            <div>
                <div class="stat-card-value" style="font-size:1rem;">Route Planning</div>
                <div class="stat-card-label">Optimized routes</div>
            </div>
        </a>
    </div>
</div>