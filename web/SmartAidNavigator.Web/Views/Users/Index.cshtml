@model List<SmartAidNavigator.Web.ViewModels.UserListItemVm>

@{
    ViewData["Title"] = "User Accounts";

    var allRoles = Model
        .SelectMany(x => (x.RolesCsv ?? "")
            .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(r => r.Trim()))
        .Where(r => !string.IsNullOrWhiteSpace(r))
        .Distinct()
        .OrderBy(r => r)
        .ToList();
}

<div class="app-page-header">
    <h2 class="page-title"><i class="fa-solid fa-users me-2"></i>User Accounts</h2>
    <a class="btn btn-primary" asp-action="Create">
        <i class="fa-solid fa-user-plus me-1"></i>Create User
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check me-1"></i>@TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>@TempData["Error"]
    </div>
}

<!-- Summary strip -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card-icon purple"><i class="fa-solid fa-users"></i></div>
            <div>
                <div class="stat-card-value">@Model.Count</div>
                <div class="stat-card-label">Total Users</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card-icon green"><i class="fa-solid fa-user-check"></i></div>
            <div>
                <div class="stat-card-value">@Model.Count(x => x.IsActive)</div>
                <div class="stat-card-label">Active</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card-icon red"><i class="fa-solid fa-user-xmark"></i></div>
            <div>
                <div class="stat-card-value">@Model.Count(x => !x.IsActive)</div>
                <div class="stat-card-label">Inactive</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-card-icon blue"><i class="fa-solid fa-shield-halved"></i></div>
            <div>
                <div class="stat-card-value">@Model.Count(x => (x.RolesCsv ?? "").Contains("ADMIN"))</div>
                <div class="stat-card-label">Admins</div>
            </div>
        </div>
    </div>
</div>

<div class="card user-filter-card mb-4">
    <div class="card-header">
        <i class="fa-solid fa-filter me-2 text-primary"></i>Filter Users
    </div>

    <div class="card-body">
        <div class="user-filter-panel">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fa-solid fa-search"></i>
                </span>
                <input type="text"
                       id="userSearchInput"
                       class="form-control"
                       placeholder="Search name, email, role, user ID..." />
            </div>

            <select id="userRoleFilter" class="form-select">
                <option value="">All Roles</option>
                @foreach (var role in allRoles)
                {
                    <option value="@role">@role</option>
                }
            </select>

            <select id="userStatusFilter" class="form-select">
                <option value="">All Status</option>
                <option value="ACTIVE">Active</option>
                <option value="INACTIVE">Inactive</option>
            </select>

            <select id="userSortSelect" class="form-select">
                <option value="id-asc" selected>User ID: Low to High</option>
                <option value="id-desc">User ID: High to Low</option>
                <option value="name-asc">Name: A to Z</option>
                <option value="name-desc">Name: Z to A</option>
                <option value="email-asc">Email: A to Z</option>
                <option value="role-asc">Role: A to Z</option>
            </select>

            <button type="button" id="clearUserFiltersBtn" class="btn btn-outline-secondary">
                Clear
            </button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="fa-solid fa-list me-2"></i>All Users</span>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border">15 records per page</span>
            <span class="badge bg-secondary">@Model.Count record(s)</span>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0" id="userTable">
                <thead>
                    <tr>
                        <th><i class="fa-solid fa-hashtag me-1"></i>ID</th>
                        <th><i class="fa-solid fa-user me-1"></i>Full Name</th>
                        <th><i class="fa-solid fa-envelope me-1"></i>Email Address</th>
                        <th><i class="fa-solid fa-id-badge me-1"></i>Roles</th>
                        <th><i class="fa-solid fa-circle-dot me-1"></i>Status</th>
                        <th style="width:220px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="userTableBody">
                    @foreach (var u in Model)
                    {
                        var rolesCsv = u.RolesCsv ?? "";
                        var statusValue = u.IsActive ? "ACTIVE" : "INACTIVE";
                        var searchText = $"{u.UserId} {u.FullName} {u.Email} {rolesCsv} {statusValue}".ToLower();

                        <tr class="user-record-row"
                            data-search="@searchText"
                            data-user-id="@u.UserId"
                            data-name="@((u.FullName ?? "").ToLower())"
                            data-email="@((u.Email ?? "").ToLower())"
                            data-roles="@rolesCsv"
                            data-status="@statusValue">
                            <td>
                                <span class="fw-semibold text-primary">#@u.UserId</span>
                            </td>

                            <td>
                                <i class="fa-solid fa-circle-user me-1 text-muted"></i>
                                <strong>@u.FullName</strong>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(u.Email))
                                {
                                    <a href="mailto:@u.Email">@u.Email</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td>
                                @foreach (var role in rolesCsv.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    var cleanRole = role.Trim();

                                    var rbg = cleanRole switch
                                    {
                                        "ADMIN" => "bg-danger",
                                        "NGO_STAFF" => "bg-primary",
                                        "SHELTER_MANAGER" => "bg-success",
                                        "PUBLIC" => "bg-info text-dark",
                                        _ => "bg-secondary"
                                    };

                                    <span class="badge @rbg me-1">@cleanRole</span>
                                }

                                @if (string.IsNullOrWhiteSpace(rolesCsv))
                                {
                                    <span class="text-muted small">No role</span>
                                }
                            </td>

                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="fa-solid fa-circle-check me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fa-solid fa-circle-xmark me-1"></i>Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    <a class="btn btn-sm btn-info"
                                       asp-action="Details"
                                       asp-route-id="@u.UserId"
                                       title="View Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    <a class="btn btn-sm btn-warning"
                                       asp-action="Edit"
                                       asp-route-id="@u.UserId"
                                       title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    @if (u.IsActive)
                                    {
                                        <form asp-action="Deactivate"
                                              asp-route-id="@u.UserId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Deactivate this user account? This user will no longer be able to login.');">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-secondary"
                                                    title="Deactivate">
                                                <i class="fa-solid fa-power-off"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reactivate"
                                              asp-route-id="@u.UserId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Reactivate this user account? This user will be able to login again.');">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-success"
                                                    title="Reactivate">
                                                <i class="fa-solid fa-rotate-left"></i>
                                            </button>
                                        </form>
                                    }

                                    <a class="btn btn-sm btn-danger"
                                       asp-action="Delete"
                                       asp-route-id="@u.UserId"
                                       title="Delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="user-table-pagination" id="userTablePagination">
                <div class="user-table-page-info" id="userTablePageInfo">
                    Showing 0 - 0 of 0 users
                </div>

                <div class="user-table-page-actions">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="userTablePrevBtn">
                        <i class="fa-solid fa-chevron-left me-1"></i>Previous
                    </button>

                    <span class="user-table-page-number" id="userTablePageNumber">
                        Page 1
                    </span>

                    <button type="button" class="btn btn-outline-secondary btn-sm" id="userTableNextBtn">
                        Next<i class="fa-solid fa-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>

            <div class="p-4 text-center text-muted d-none" id="noUserSearchResult">
                <i class="fa-solid fa-search fa-2x mb-2 text-primary"></i>
                <div class="fw-semibold">No matching users found.</div>
                <div class="small">Try changing your search or filters.</div>
            </div>
        }
        else
        {
            <div class="p-3 text-muted small">
                <i class="fa-solid fa-inbox me-1"></i>No users found.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const pageSize = 15;

            const searchInput = document.getElementById('userSearchInput');
            const roleFilter = document.getElementById('userRoleFilter');
            const statusFilter = document.getElementById('userStatusFilter');
            const sortSelect = document.getElementById('userSortSelect');
            const clearBtn = document.getElementById('clearUserFiltersBtn');

            const tableBody = document.getElementById('userTableBody');
            const rows = Array.from(document.querySelectorAll('tr.user-record-row'));

            const pagination = document.getElementById('userTablePagination');
            const pageInfo = document.getElementById('userTablePageInfo');
            const pageNumber = document.getElementById('userTablePageNumber');
            const prevBtn = document.getElementById('userTablePrevBtn');
            const nextBtn = document.getElementById('userTableNextBtn');
            const noResult = document.getElementById('noUserSearchResult');

            let currentPage = 1;
            let filteredRows = [...rows];

            function sortRows() {
                if (!tableBody || !sortSelect) return;

                const mode = sortSelect.value;

                rows.sort((a, b) => {
                    const aId = parseInt(a.dataset.userId || '0', 10);
                    const bId = parseInt(b.dataset.userId || '0', 10);

                    const aName = a.dataset.name || '';
                    const bName = b.dataset.name || '';

                    const aEmail = a.dataset.email || '';
                    const bEmail = b.dataset.email || '';

                    const aRole = a.dataset.roles || '';
                    const bRole = b.dataset.roles || '';

                    switch (mode) {
                        case 'id-desc':
                            return bId - aId;

                        case 'name-asc':
                            return aName.localeCompare(bName) || aId - bId;

                        case 'name-desc':
                            return bName.localeCompare(aName) || aId - bId;

                        case 'email-asc':
                            return aEmail.localeCompare(bEmail) || aId - bId;

                        case 'role-asc':
                            return aRole.localeCompare(bRole) || aId - bId;

                        case 'id-asc':
                        default:
                            return aId - bId;
                    }
                });

                rows.forEach(row => tableBody.appendChild(row));
            }

            function filterRows() {
                const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
                const role = roleFilter ? roleFilter.value : '';
                const status = statusFilter ? statusFilter.value : '';

                filteredRows = rows.filter(row => {
                    const text = row.dataset.search || '';
                    const rowRoles = row.dataset.roles || '';
                    const rowStatus = row.dataset.status || '';

                    const matchesSearch = text.includes(query);
                    const matchesRole = !role || rowRoles.includes(role);
                    const matchesStatus = !status || rowStatus === status;

                    return matchesSearch && matchesRole && matchesStatus;
                });

                currentPage = 1;
            }

            function renderPage() {
                const total = filteredRows.length;
                const totalPages = Math.max(Math.ceil(total / pageSize), 1);

                if (currentPage > totalPages) {
                    currentPage = totalPages;
                }

                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = startIndex + pageSize;
                const visibleSet = new Set(filteredRows.slice(startIndex, endIndex));

                rows.forEach(row => {
                    row.classList.toggle('d-none', !visibleSet.has(row));
                });

                if (pagination) {
                    pagination.classList.toggle('d-none', total === 0);
                }

                if (noResult) {
                    noResult.classList.toggle('d-none', total > 0);
                }

                if (pageInfo) {
                    const from = total > 0 ? startIndex + 1 : 0;
                    const to = Math.min(endIndex, total);
                    pageInfo.textContent = `Showing ${from} - ${to} of ${total} users`;
                }

                if (pageNumber) {
                    pageNumber.textContent = `Page ${currentPage} of ${totalPages}`;
                }

                if (prevBtn) {
                    prevBtn.disabled = currentPage <= 1;
                }

                if (nextBtn) {
                    nextBtn.disabled = currentPage >= totalPages;
                }
            }

            function refreshTable() {
                sortRows();
                filterRows();
                renderPage();
            }

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    filterRows();
                    renderPage();
                });
            }

            if (roleFilter) {
                roleFilter.addEventListener('change', function () {
                    filterRows();
                    renderPage();
                });
            }

            if (statusFilter) {
                statusFilter.addEventListener('change', function () {
                    filterRows();
                    renderPage();
                });
            }

            if (sortSelect) {
                sortSelect.addEventListener('change', function () {
                    currentPage = 1;
                    sortRows();
                    filterRows();
                    renderPage();
                });
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    if (searchInput) searchInput.value = '';
                    if (roleFilter) roleFilter.value = '';
                    if (statusFilter) statusFilter.value = '';
                    if (sortSelect) sortSelect.value = 'id-asc';

                    refreshTable();
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', function () {
                    if (currentPage > 1) {
                        currentPage--;
                        renderPage();
                    }
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function () {
                    const totalPages = Math.max(Math.ceil(filteredRows.length / pageSize), 1);

                    if (currentPage < totalPages) {
                        currentPage++;
                        renderPage();
                    }
                });
            }

            refreshTable();
        });
    </script>
}