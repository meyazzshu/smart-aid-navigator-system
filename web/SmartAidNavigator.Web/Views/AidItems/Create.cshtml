@model SmartAidNavigator.Web.Models.AidItem
@{
    ViewData["Title"] = "Create Item";
}

<div class="app-page-header">
    <h2 class="page-title"><i class="fa-solid fa-cube me-2"></i>New Aid Item</h2>
    <a class="btn btn-secondary" asp-action="Index"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
</div>

<div class="app-form-card">
    <div class="card">
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Category</label>
                    <select class="form-select" asp-for="CategoryId" asp-items="ViewBag.Categories">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span class="text-danger" asp-validation-for="CategoryId"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Item Name</label>
                    <input class="form-control" asp-for="ItemName" placeholder="Enter item name" />
                    <span class="text-danger" asp-validation-for="ItemName"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Unit</label>
                    <input class="form-control" asp-for="Unit" placeholder="e.g. kg, pcs, box" />
                    <span class="text-danger" asp-validation-for="Unit"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="IsActive" />
                    <label class="form-check-label">Active</label>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>Save</button>
                    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
