        </header>

        <div class="app-content @(isAuthPage ? "app-content-auth" : "")">
            <main role="main">
                @RenderBody()
            </main>
        </div>

        <footer class="app-footer border-top">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
