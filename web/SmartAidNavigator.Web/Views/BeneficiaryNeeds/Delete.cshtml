@model SmartAidNavigator.Web.Models.BeneficiaryNeed

@{
    ViewData["Title"] = "Delete Need";
}

<div class="app-page-header">
    <div>
        <h2 class="page-title text-danger">
            <i class="fa-solid fa-trash me-2"></i>Delete Beneficiary Need
        </h2>
        <p class="text-muted mb-0">
            Confirm before removing this need record.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Back
    </a>
</div>

<div class="alert alert-warning">
    <i class="fa-solid fa-triangle-exclamation me-2"></i>
    Are you sure you want to delete this beneficiary need record?
</div>

<div class="card">
    <div class="card-header">
        <i class="fa-solid fa-circle-info me-2 text-primary"></i>Need Summary
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-md-3">Beneficiary</dt>
            <dd class="col-md-9">@(Model.Beneficiary?.Person?.FullName ?? "-")</dd>

            <dt class="col-md-3">Aid Item</dt>
            <dd class="col-md-9">@(Model.Item?.ItemName ?? "-")</dd>

            <dt class="col-md-3">Required Quantity</dt>
            <dd class="col-md-9">@Model.RequiredQuantity</dd>

            <dt class="col-md-3">Priority</dt>
            <dd class="col-md-9">@Model.Priority</dd>

            <dt class="col-md-3">Notes</dt>
            <dd class="col-md-9">@(Model.Notes ?? "-")</dd>

            <dt class="col-md-3">Date Logged</dt>
            <dd class="col-md-9">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.NeedId" method="post" class="mt-3">
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        <i class="fa-solid fa-trash me-1"></i>Yes, Delete
    </button>

    <a asp-action="Details" asp-route-id="@Model.NeedId" class="btn btn-secondary">
        Cancel
    </a>
</form>