@model SmartAidNavigator.Web.ViewModels.ShelterRequestDetailVm
@using SmartAidNavigator.Web.Helpers

@{
    ViewData["Title"] = "Shelter Request Details";
    var r = Model.Request;
    var requester = r.User?.Person;
    var readonlyMode = r.Status == "ARRIVED";
}

<div class="app-page-header">
    <h2 class="page-title">
        <i class="fa-solid fa-person-shelter me-2"></i>Request #@r.RequestId
    </h2>

    <a asp-controller="ShelterRequests" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header">
                <i class="fa-solid fa-user me-2 text-primary"></i>Requester Details
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@(requester?.FullName ?? "-")</dd>

                    <dt class="col-sm-4">IC / Passport</dt>
                    <dd class="col-sm-8">@(requester?.IcOrPassport ?? "-")</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(requester?.Phone ?? "-")</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@(requester?.Email ?? "-")</dd>

                    <dt class="col-sm-4">Gender</dt>
                    <dd class="col-sm-8">@(requester?.Gender ?? "-")</dd>

                    <dt class="col-sm-4">Age</dt>
                    <dd class="col-sm-8">@(PersonHelper.CalculateAge(requester?.DateOfBirth)?.ToString() ?? "-")</dd>

                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">
                        @(requester?.AddressLine ?? "-")
                        <div class="text-muted small">
                            @(requester?.City ?? "") @(requester?.State ?? "") @(requester?.PostalCode ?? "")
                        </div>
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <i class="fa-solid fa-people-group me-2 text-primary"></i>Dependents in This Request
            </div>

            <div class="card-body p-0">
                @if (r.Dependents == null || !r.Dependents.Any())
                {
                    <div class="p-3 text-muted small">No dependents assigned.</div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Relationship</th>
                                <th>Gender</th>
                                <th>Age</th>
                                <th>Contact</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in r.Dependents)
                            {
                                var p = d.Relationship?.RelatedPerson;

                                <tr>
                                    <td>
                                        <strong>@(p?.FullName ?? "-")</strong>
                                        <div class="text-muted small">@(p?.IcOrPassport ?? "-")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@(d.Relationship?.RelationshipType ?? "-")</span>
                                    </td>
                                    <td>@(p?.Gender ?? "-")</td>
                                    <td>@(PersonHelper.CalculateAge(p?.DateOfBirth)?.ToString() ?? "-")</td>
                                    <td>
                                        <div>@(p?.Phone ?? "-")</div>
                                        <div class="text-muted small">@(p?.Email ?? "-")</div>
                                    </td>
                                    <td>
                                        @if (!readonlyMode)
                                        {
                                            <form asp-controller="ShelterRequests" asp-action="RemoveDependent" method="post"
                                                  onsubmit="return confirm('Remove this dependent from request?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requestDependentId" value="@d.RequestDependentId" />
                                                <input type="hidden" name="requestId" value="@r.RequestId" />
                                                <button class="btn btn-sm btn-outline-danger">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header">
                <i class="fa-solid fa-chart-simple me-2 text-primary"></i>Request Headcount
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label">Babies Male</label>
                        <input value="@r.BabiesMale" class="form-control" readonly />
                    </div>

                    <div class="col-6">
                        <label class="form-label">Babies Female</label>
                        <input value="@r.BabiesFemale" class="form-control" readonly />
                    </div>

                    <div class="col-6">
                        <label class="form-label">Kids Male</label>
                        <input value="@r.KidsMale" class="form-control" readonly />
                    </div>

                    <div class="col-6">
                        <label class="form-label">Kids Female</label>
                        <input value="@r.KidsFemale" class="form-control" readonly />
                    </div>

                    <div class="col-6">
                        <label class="form-label">Adult Male</label>
                        <input value="@r.AdultMale" class="form-control" readonly />
                    </div>

                    <div class="col-6">
                        <label class="form-label">Adult Female</label>
                        <input value="@r.AdultFemale" class="form-control" readonly />
                    </div>
                </div>

                <div class="mt-3">
                    <strong>Total People:</strong> @r.TotalPeople
                </div>
            </div>
        </div>

        @if (!readonlyMode)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-person-circle-plus me-2 text-success"></i>Add Dependent
                </div>
                <div class="card-body">
                    <form asp-controller="ShelterRequests" asp-action="AddDependent" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="NewDependent.RequestId" />

                        <div class="mb-2">
                            <label class="form-label">Full Name</label>
                            <input asp-for="NewDependent.FullName" class="form-control" />
                        </div>

                        <div class="mb-2">
                            <label class="form-label">IC / Passport</label>
                            <input asp-for="NewDependent.IcOrPassport" class="form-control" />
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label">Gender</label>
                                <select asp-for="NewDependent.Gender" class="form-select">
                                    <option value="">-</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label">Date of Birth</label>
                                <input asp-for="NewDependent.DateOfBirth" class="form-control" type="date" />
                            </div>
                        </div>

                        <div class="mb-2 mt-2">
                            <label class="form-label">Relationship</label>
                            <select asp-for="NewDependent.RelationshipType" class="form-select">
                                <option value="CHILD">Child</option>
                                <option value="SPOUSE">Spouse</option>
                                <option value="PARENT">Parent</option>
                                <option value="SIBLING">Sibling</option>
                                <option value="GRANDCHILD">Grandchild</option>
                                <option value="EXTENDED_FAMILY">Extended Family</option>
                                <option value="OTHER">Other</option>
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Phone</label>
                            <input asp-for="NewDependent.Phone" class="form-control" />
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Email</label>
                            <input asp-for="NewDependent.Email" class="form-control" />
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="sameAddressCheckbox"
                                   onchange="toggleSameAddress()" />
                            <label class="form-check-label" for="sameAddressCheckbox">
                                Same Address As Requester
                            </label>
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Address Line</label>
                            <textarea asp-for="NewDependent.AddressLine"
                                      class="form-control"
                                      id="depAddressLine"></textarea>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">City</label>
                                <input asp-for="NewDependent.City"
                                       class="form-control"
                                       id="depCity" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">State</label>
                                <select asp-for="NewDependent.State"
                                        class="form-select"
                                        id="depState">
                                    <option value="">- Select State -</option>
                                    <option value="Johor">Johor</option>
                                    <option value="Kedah">Kedah</option>
                                    <option value="Kelantan">Kelantan</option>
                                    <option value="Melaka">Melaka</option>
                                    <option value="Negeri Sembilan">Negeri Sembilan</option>
                                    <option value="Pahang">Pahang</option>
                                    <option value="Perak">Perak</option>
                                    <option value="Perlis">Perlis</option>
                                    <option value="Pulau Pinang">Pulau Pinang</option>
                                    <option value="Sabah">Sabah</option>
                                    <option value="Sarawak">Sarawak</option>
                                    <option value="Selangor">Selangor</option>
                                    <option value="Terengganu">Terengganu</option>
                                    <option value="Kuala Lumpur">Kuala Lumpur</option>
                                    <option value="Labuan">Labuan</option>
                                    <option value="Putrajaya">Putrajaya</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Postal Code</label>
                                <input asp-for="NewDependent.PostalCode"
                                       class="form-control"
                                       id="depPostalCode" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 mt-3">
                            <i class="fa-solid fa-plus me-1"></i>Add Dependent
                        </button>
                    </form>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-gears me-2 text-primary"></i>Actions
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @if (!readonlyMode)
                    {
                        <form asp-controller="ShelterRequests" asp-action="ConfirmArrival" asp-route-id="@r.RequestId" method="post"
                              onsubmit="return confirm('Confirm requester has arrived? This will register requester and dependents as beneficiaries.')">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-success w-100">
                                <i class="fa-solid fa-circle-check me-1"></i>Confirm Arrived
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-success mb-0">
                            <i class="fa-solid fa-circle-check me-1"></i>This request has arrived.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const requesterAddress = {
            addressLine: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(requester?.AddressLine ?? "")),
            city: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(requester?.City ?? "")),
            state: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(requester?.State ?? "")),
            postalCode: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(requester?.PostalCode ?? ""))
        };

        function toggleSameAddress() {
            const checked = document.getElementById('sameAddressCheckbox').checked;

            const addressLine = document.getElementById('depAddressLine');
            const city = document.getElementById('depCity');
            const state = document.getElementById('depState');
            const postalCode = document.getElementById('depPostalCode');

            if (checked) {
                addressLine.value = requesterAddress.addressLine;
                city.value = requesterAddress.city;
                state.value = requesterAddress.state;
                postalCode.value = requesterAddress.postalCode;
            } else {
                addressLine.value = "";
                city.value = "";
                state.value = "";
                postalCode.value = "";
            }
        }
    </script>
}