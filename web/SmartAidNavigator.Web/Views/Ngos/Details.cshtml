@model SmartAidNavigator.Web.Models.Ngo

@{
    ViewData["Title"] = "NGO Details";

    var fullAddress = string.Join(", ", new[]
    {
        Model.AddressLine,
        Model.City,
        Model.State,
        Model.PostalCode
    }.Where(x => !string.IsNullOrWhiteSpace(x)));

    var hasLocation = Model.Latitude.HasValue && Model.Longitude.HasValue;
}

<div class="app-page-header">
    <div>
        <h2 class="page-title">
            <i class="fa-solid fa-building-ngo me-2"></i>NGO Details
        </h2>
        <p class="text-muted mb-0">View NGO profile, contact details, status, and map location.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.NgoId" class="btn btn-warning">
            <i class="fa-solid fa-pen me-1"></i>Edit
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check me-1"></i>@TempData["Success"]
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="org-detail-avatar mx-auto mb-3">
                    <i class="fa-solid fa-building-ngo"></i>
                </div>

                <h4 class="mb-1">@Model.NgoName</h4>

                <div class="mb-3">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            <i class="fa-solid fa-circle-check me-1"></i>Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            <i class="fa-solid fa-circle-xmark me-1"></i>Inactive / Pending
                        </span>
                    }

                    @if (Model.IsTaxExempt)
                    {
                        <span class="badge bg-info text-dark ms-1">
                            <i class="fa-solid fa-receipt me-1"></i>Tax Exempt
                        </span>
                    }
                </div>

                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.NgoId" class="btn btn-warning">
                        <i class="fa-solid fa-pen me-1"></i>Edit NGO
                    </a>

                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <a href="mailto:@Model.Email" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-envelope me-1"></i>Email NGO
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <a href="tel:@Model.Phone" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-phone me-1"></i>Call NGO
                        </a>
                    }

                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">
                <i class="fa-solid fa-circle-info me-2 text-primary"></i>Organization Information
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="detail-label">NGO ID</div>
                        <div class="detail-value">#@Model.NgoId</div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-label">Created At</div>
                        <div class="detail-value">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-label">Phone</div>
                        <div class="detail-value">@(Model.Phone ?? "-")</div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-label">Email</div>
                        <div class="detail-value">@(Model.Email ?? "-")</div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-label">Tax Exemption</div>
                        <div class="detail-value">@(Model.IsTaxExempt ? "Yes" : "No")</div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-label">Tax Exemption Number</div>
                        <div class="detail-value">@(Model.TaxExemptionNo ?? "-")</div>
                    </div>

                    <div class="col-12">
                        <div class="detail-label">Description</div>
                        <div class="detail-value">@(Model.Description ?? "-")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <i class="fa-solid fa-location-dot me-2 text-primary"></i>Location Information
            </div>

            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="detail-label">Address</div>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(fullAddress) ? "-" : fullAddress)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="detail-label">Latitude</div>
                        <div class="detail-value">@(Model.Latitude?.ToString() ?? "-")</div>
                    </div>

                    <div class="col-md-3">
                        <div class="detail-label">Longitude</div>
                        <div class="detail-value">@(Model.Longitude?.ToString() ?? "-")</div>
                    </div>
                </div>

                @if (hasLocation)
                {
                    <div id="ngoDetailsMap"
                         class="org-details-map"
                         data-lat="@Model.Latitude"
                         data-lng="@Model.Longitude"
                         data-title="@Model.NgoName">
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        No latitude and longitude saved for this NGO.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (hasLocation && !string.IsNullOrWhiteSpace(ViewBag.GoogleMapsApiKey as string))
    {
        <script>
            function initNgoDetailsMap() {
                const mapEl = document.getElementById('ngoDetailsMap');

                if (!mapEl) return;

                const lat = parseFloat(mapEl.dataset.lat);
                const lng = parseFloat(mapEl.dataset.lng);
                const title = mapEl.dataset.title || 'NGO Location';

                const position = { lat: lat, lng: lng };

                const map = new google.maps.Map(mapEl, {
                    center: position,
                    zoom: 16,
                    mapTypeControl: false,
                    streetViewControl: false,
                    fullscreenControl: true
                });

                new google.maps.Marker({
                    map: map,
                    position: position,
                    title: title
                });
            }
        </script>

        <script async
                defer
                src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&callback=initNgoDetailsMap">
        </script>
    }
}