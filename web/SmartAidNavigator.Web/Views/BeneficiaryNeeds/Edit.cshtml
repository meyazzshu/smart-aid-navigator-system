@model SmartAidNavigator.Web.Models.BeneficiaryNeed

@{
    ViewData["Title"] = "Edit Need";

    var b = ViewBag.Beneficiary as SmartAidNavigator.Web.Models.Beneficiary;
    var items = ViewBag.Items as List<SmartAidNavigator.Web.Models.AidItem> ?? new();
}

<div class="app-page-header">
    <div>
        <h2 class="page-title">
            <i class="fa-solid fa-pen me-2"></i>Edit Beneficiary Need
        </h2>
        <p class="text-muted mb-0">
            Update aid item, quantity, priority, and notes.
        </p>
    </div>

    <a asp-action="Details" asp-route-id="@Model.NeedId" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Back
    </a>
</div>

<form asp-action="Edit" asp-route-id="@Model.NeedId" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="NeedId" />
    <input type="hidden" asp-for="BeneficiaryId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card staff-edit-summary-card">
                <div class="card-body text-center">
                    <div class="staff-detail-avatar mx-auto mb-3">
                        <i class="fa-solid fa-hand-holding-heart"></i>
                    </div>

                    <h4 class="mb-1">@(b?.Person?.FullName ?? "Beneficiary")</h4>
                    <div class="text-muted mb-3">Need ID: #@Model.NeedId</div>

                    <div class="mb-3">
                        <span class="badge bg-primary">
                            <i class="fa-solid fa-pen me-1"></i>Editing Need
                        </span>
                    </div>

                    <div class="staff-edit-mini-info">
                        <div>
                            <i class="fa-solid fa-box me-2 text-primary"></i>
                            <span>Update aid item needed</span>
                        </div>

                        <div>
                            <i class="fa-solid fa-arrow-up-wide-short me-2 text-primary"></i>
                            <span>Set need priority</span>
                        </div>
                    </div>

                    <hr />

                    <button type="submit" class="btn btn-primary w-100 mb-2">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Save Changes
                    </button>

                    <a asp-action="Details" asp-route-id="@Model.NeedId" class="btn btn-info w-100 mb-2">
                        <i class="fa-solid fa-eye me-1"></i>View Details
                    </a>

                    <a asp-action="Index" class="btn btn-secondary w-100">
                        Cancel
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa-solid fa-box me-2 text-primary"></i>Need Information
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ItemId" class="form-label fw-semibold">
                                <i class="fa-solid fa-box-open me-1 text-primary"></i>Aid Item Needed
                            </label>
                            <select asp-for="ItemId" class="form-select">
                                <option value="">-- Select Item --</option>
                                @foreach (var it in items)
                                {
                                    <option value="@it.ItemId">@it.ItemName (@it.Unit)</option>
                                }
                            </select>
                            <span asp-validation-for="ItemId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RequiredQuantity" class="form-label fw-semibold">
                                <i class="fa-solid fa-hashtag me-1 text-primary"></i>Required Quantity
                            </label>
                            <input asp-for="RequiredQuantity" class="form-control" type="number" min="1" />
                            <span asp-validation-for="RequiredQuantity" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold">
                                <i class="fa-solid fa-arrow-up-wide-short me-1 text-primary"></i>Priority
                            </label>
                            <select asp-for="Priority" class="form-select">
                                <option value="LOW">LOW</option>
                                <option value="MEDIUM">MEDIUM</option>
                                <option value="HIGH">HIGH</option>
                                <option value="CRITICAL">CRITICAL</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold">
                                <i class="fa-solid fa-note-sticky me-1 text-primary"></i>Notes
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Optional notes..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-3">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>

                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}