@model SmartAidNavigator.Web.ViewModels.Reports.ReportVm

@{
    ViewData["Title"] = Model.Title;
}

<div class="app-page-header">
    <div>
        <h2 class="page-title">
            <i class="fa-solid fa-file-lines me-2"></i>@Model.Title
        </h2>
        <p class="text-muted mb-0">@Model.Subtitle</p>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-danger"
           asp-action="@Model.PdfAction">
            <i class="fa-solid fa-file-pdf me-1"></i>Export PDF
        </a>

        <a class="btn btn-outline-secondary"
           asp-action="@Model.BackAction">
            <i class="fa-solid fa-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    @foreach (var stat in Model.Stats)
    {
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-card-icon @stat.Color">
                    <i class="@stat.Icon"></i>
                </div>
                <div>
                    <div class="stat-card-value">@stat.Value</div>
                    <div class="stat-card-label">@stat.Label</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span>
            <i class="fa-solid fa-table me-2 text-primary"></i>Report Data
        </span>
        <span class="badge bg-secondary">@Model.Rows.Count record(s)</span>
    </div>

    <div class="card-body p-0">
        @if (Model.Rows.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            @foreach (var col in Model.Columns)
                            {
                                <th>@col</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                @foreach (var cell in row)
                                {
                                    <td style="max-width:360px; word-break:break-word;">@cell</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3 text-muted small">
                <i class="fa-solid fa-inbox me-1"></i>No records found for this report.
            </div>
        }
    </div>
</div>