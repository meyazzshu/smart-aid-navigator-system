@model IEnumerable<SmartAidNavigator.Web.Models.BeneficiaryNeed>

@{
    ViewData["Title"] = "Beneficiary Needs";
    var b = ViewBag.Beneficiary as SmartAidNavigator.Web.Models.Beneficiary;
}

<div class="app-page-header">
    <div>
        <h2 class="page-title">
            <i class="fa-solid fa-hand-holding-heart me-2"></i>Beneficiary Needs
        </h2>
        <p class="text-muted mb-0">
            Manage aid needs recorded for @(b?.Person?.FullName ?? "this beneficiary").
        </p>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary"
           asp-controller="Beneficiaries"
           asp-action="Index">
            <i class="fa-solid fa-arrow-left me-1"></i>Back
        </a>

        <a class="btn btn-primary"
           asp-action="Create"
           asp-route-beneficiaryId="@(b?.BeneficiaryId ?? 0)">
            <i class="fa-solid fa-plus me-1"></i>Add Need
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <span>
            <i class="fa-solid fa-list me-2 text-primary"></i>
            Recorded Needs
        </span>

        <span class="badge bg-secondary">
            @(Model?.Count() ?? 0) record(s)
        </span>
    </div>

    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="p-4 text-muted small">
                <i class="fa-solid fa-inbox me-1"></i>
                No needs recorded yet for this beneficiary.
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th><i class="fa-solid fa-box me-1"></i>Item</th>
                        <th><i class="fa-solid fa-hashtag me-1"></i>Qty</th>
                        <th><i class="fa-solid fa-circle-exclamation me-1"></i>Priority</th>
                        <th><i class="fa-solid fa-note-sticky me-1"></i>Notes</th>
                        <th><i class="fa-solid fa-calendar me-1"></i>Created</th>
                        <th style="width:140px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var need in Model)
                    {
                        var priorityClass = need.Priority switch
                        {
                            "CRITICAL" => "bg-danger",
                            "HIGH" => "bg-danger",
                            "MEDIUM" => "bg-warning text-dark",
                            "LOW" => "bg-success",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td>
                                <strong>@(need.Item?.ItemName ?? "-")</strong>
                                <div class="text-muted small">
                                    Need ID: @need.NeedId
                                </div>
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @need.RequiredQuantity
                                </span>
                            </td>

                            <td>
                                <span class="badge @priorityClass">
                                    @need.Priority
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(need.Notes) ? "-" : need.Notes)
                            </td>

                            <td class="text-muted small">
                                @need.CreatedAt.ToString("dd MMM yyyy")
                            </td>

                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-info"
                                   asp-action="Details"
                                   asp-route-id="@need.NeedId"
                                   title="View Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>

                                <a class="btn btn-sm btn-warning"
                                   asp-action="Edit"
                                   asp-route-id="@need.NeedId"
                                   title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>

                                <a class="btn btn-sm btn-danger"
                                   asp-action="Delete"
                                   asp-route-id="@need.NeedId"
                                   title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>