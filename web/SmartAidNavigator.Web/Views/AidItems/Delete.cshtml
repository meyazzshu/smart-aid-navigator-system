@model SmartAidNavigator.Web.Models.AidItem
@{
    ViewData["Title"] = "Delete Item";
}

<div class="app-page-header">
    <h2 class="page-title"><i class="fa-solid fa-trash me-2 text-danger"></i>Delete Item</h2>
    <a class="btn btn-secondary" asp-action="Index"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
</div>

<div class="app-form-card">
    <div class="card border-danger">
        <div class="card-header text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Confirm Deletion</div>
        <div class="card-body">
            <p>Are you sure you want to delete <strong>@Model.ItemName</strong>? This action cannot be undone.</p>
            <dl class="row mb-3">
                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "-")</dd>
                <dt class="col-sm-4">Unit</dt>
                <dd class="col-sm-8">@Model.Unit</dd>
                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@(Model.IsActive ? "Active" : "Inactive")</dd>
            </dl>
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ItemId" />
                <div class="d-flex gap-2">
                    <button class="btn btn-danger" type="submit"><i class="fa-solid fa-trash me-1"></i>Yes, Delete</button>
                    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
