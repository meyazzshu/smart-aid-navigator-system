@model SmartAidNavigator.Web.ViewModels.StockAdjustVm
@{
    ViewData["Title"] = "Adjust Stock";
}

<div class="app-page-header">
    <h2 class="page-title"><i class="fa-solid fa-sliders me-2"></i>Adjust Stock: @ViewBag.ItemName</h2>
    <a class="btn btn-secondary" asp-action="Index"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
</div>

<div class="app-form-card">
    <div class="card">
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ItemId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Transaction Type</label>
                    <select class="form-select" asp-for="TransactionType">
                        <option value="IN"><i class="fa-solid fa-arrow-down"></i> IN (Received)</option>
                        <option value="OUT">OUT (Used / Distributed)</option>
                        <option value="ADJUST">ADJUST (Set exact quantity)</option>
                    </select>
                    <span class="text-danger" asp-validation-for="TransactionType"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Quantity</label>
                    <input class="form-control" asp-for="Quantity" type="number" min="0" />
                    <span class="text-danger" asp-validation-for="Quantity"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Note <span class="text-muted fw-normal">(optional)</span></label>
                    <input class="form-control" asp-for="Note" placeholder="e.g. Weekly distribution" />
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>Save</button>
                    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
