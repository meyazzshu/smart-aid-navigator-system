@model SmartAidNavigator.Web.Models.Ngo
@{
    ViewData["Title"] = "NGO Details";
}

<div class="app-page-header">
    <h2 class="page-title"><i class="fa-solid fa-building-ngo me-2"></i>NGO Details</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.NgoId"><i class="fa-solid fa-pen me-1"></i>Edit</a>
        <a class="btn btn-secondary" asp-action="Index"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="card">
    <div class="card-header"><i class="fa-solid fa-circle-info me-2"></i>Organisation Information</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9"><strong>@Model.NgoName</strong></dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "-")</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email ?? "-")</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(Model.Phone ?? "-")</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@(Model.AddressLine ?? "-")</dd>

            <dt class="col-sm-3">City</dt>
            <dd class="col-sm-9">@(Model.City ?? "-")</dd>

            <dt class="col-sm-3">State</dt>
            <dd class="col-sm-9">@(Model.State ?? "-")</dd>

            <dt class="col-sm-3">Postal Code</dt>
            <dd class="col-sm-9">@(Model.PostalCode ?? "-")</dd>

            <dt class="col-sm-3">Coordinates</dt>
            <dd class="col-sm-9">
                <i class="fa-solid fa-location-dot me-1 text-muted"></i>@Model.Latitude, @Model.Longitude
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Active</span>
                }
                else
                {
                    <span class="badge bg-secondary"><i class="fa-solid fa-circle-xmark me-1"></i>Inactive</span>
                }
            </dd>
        </dl>
    </div>
</div>
